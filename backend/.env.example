INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=replace-with-influx-token
INFLUXDB_ORG=aqua_sense
INFLUXDB_BUCKET=Test_Data
INFLUXDB_MEASUREMENT=atbc_packet

# Incremental hourly forecast cache. The default bucket may be the raw bucket;
# a separate measurement keeps derived rows isolated from sensor telemetry.
FORECAST_HOURLY_BUCKET=Test_Data
FORECAST_HOURLY_MEASUREMENT=pumpwatch_hourly_forecast
FORECAST_HOURLY_PIPELINE_VERSION=2
FORECAST_HOURLY_REPROCESS_HOURS=3
FORECAST_REFRESH_MINUTES=360

BASELINE_STORE=mongodb
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=Ftu_localDB
MONGODB_EVENT_COLLECTION=pumpwatch_issue_events
MONGODB_BASELINE_COLLECTION=pumpwatch_baselines
MONGODB_TIMEOUT_MS=5000

ALLOWED_CORS_ORIGINS=http://localhost:5173

# Engineer profiles (approved limits) and their change history.
PROFILE_MONGODB_URI=mongodb://localhost:27017
PROFILE_MONGODB_DATABASE=Ftu_localDB

# Required: keys for the admin form and engineer APIs. Use long random values.
ENGINEER_API_KEY=replace-with-engineer-key
ADMIN_API_KEY=replace-with-admin-key

# Optional tuning (defaults shown). "Check minimum flow from data" button:
# FLOW_SUGGESTION_MARGIN_PERCENT=30
# FLOW_SUGGESTION_MIN_RUNNING_HOURS=12
# FLOW_SUGGESTION_OUTLIER_WARNING_PERCENT=20
# FLOW_SUGGESTION_LOOKBACK_DAYS=7,30
